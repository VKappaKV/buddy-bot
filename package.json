{
  "name": "buddy-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm env:check && pnpm typecheck && pnpm lint && pnpm format:check",
    "env:check": "varlock load --path .env.schema",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "lint": "oxlint --deny-warnings alchemy.run.ts src scripts test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "dev": "varlock run --inject vars -- alchemy dev",
    "dev:phone": "varlock run --inject vars --path .env.schema --path .dev.vars --path .dev.vars.phone -- alchemy dev",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@chat-adapter/whatsapp": "4.45.0",
    "chat": "4.45.0",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261120.1",
    "@effect/platform-node": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.87",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "5.9.3",
    "varlock": "1.25.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
