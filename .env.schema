# @defaultRequired=false @defaultSensitive=false
# ---

# Abilita il bot Telegram di test con credenziali reali e archivi locali.
# @type=boolean
BUDDY_TELEGRAM_PHONE_TEST=false

# Porta dell’API Telegram simulata sulla macchina locale.
# @type=port
BUDDY_TEST_TELEGRAM_PORT=

# Token del bot di prova. TELEGRAM_TOKEN è l’alias letto dai file precedenti.
# @sensitive @required=eq($BUDDY_TELEGRAM_PHONE_TEST, true)
TELEGRAM_BOT_TOKEN=fallback($TELEGRAM_TOKEN, "")

# @sensitive
TELEGRAM_TOKEN=

# @sensitive @required=eq($BUDDY_TELEGRAM_PHONE_TEST, true)
TELEGRAM_WEBHOOK_SECRET=

# @sensitive @required=eq($BUDDY_TELEGRAM_PHONE_TEST, true)
TELEGRAM_PAIR_CODE=

# I file di prova esistenti possono contenere questi due valori di WhatsApp.
# @sensitive
WHATSAPP_VERIFY_TOKEN=

# @sensitive
WHATSAPP_PAIR_CODE=
